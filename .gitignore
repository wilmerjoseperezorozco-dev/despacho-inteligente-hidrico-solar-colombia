# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Directorios temporales de scripts de descarga/delineacion (cache de DEM, rasters globales, etc.)
scripts/_tmp_*/
**/_tmp_globales/

# Datos (no versionar series descargadas ni procesadas pesadas)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Excepcion: poligonos de cuenca delineados (livianos, son insumo de referencia, no datos crudos)
!data/processed/cuencas/
!data/processed/cuencas/*.geojson
# Excepcion: resumenes de calidad/cobertura de series IDEAM (livianos, no son la serie cruda)
!data/processed/ideam/
!data/processed/ideam/*.csv
# Excepcion: resumen de aportes hidricos XM (liviano, no es la serie cruda completa)
!data/processed/xm/
!data/processed/xm/*.csv
# Excepcion: dataset consolidado de Fase 1 (el entregable real, no datos crudos)
!data/processed/dataset_fase1_diario.csv
# Excepcion: resultados y predicciones del modelo baseline (livianos, son resultados no datos crudos)
!data/processed/baseline_resultados*.csv
!data/processed/baseline_predicciones_*.csv
# Excepcion: resultados, importancias y predicciones del modelo GBM
!data/processed/gbm_resultados_*.csv
!data/processed/gbm_importancias_*.csv
!data/processed/gbm_predicciones_*.csv
# Excepcion: resultados del modelo GBM v2 (regularizado + walk-forward), incl. variantes de experimentos
!data/processed/gbm_v2_*.csv
# Excepcion: predicciones del modelo de picos (issue #3)
!data/processed/picos_predicciones_*.csv
# Excepcion: series de Fase 3 - embalse, generacion, obligacion firme y aportes en energia (XM)
!data/raw/xm_embalse_generacion/
!data/raw/xm_embalse_generacion/*.csv
!data/raw/xm_aportes_energia/
!data/raw/xm_aportes_energia/*.csv
# Excepcion: irradiancia solar diaria (NASA POWER) para el modelo FV flotante simulado
!data/raw/solar_power/
!data/raw/solar_power/*.csv
# Excepcion: dataset consolidado y resultados del motor de despacho (Fase 3)
!data/processed/dataset_fase3_despacho.csv
!data/processed/solar_flotante_escenarios.csv
!data/processed/despacho_resultados_*.csv
# Excepcion: replica en Urra I (issue #14) - mismo criterio que Guatape
!data/raw/xm_urra/
!data/raw/xm_urra/*.csv
!data/raw/solar_power_urra/
!data/raw/solar_power_urra/*.csv
!data/processed/cuenca_solar_urra_escenarios.csv
!data/processed/dataset_urra_diario.csv

# Modelos entrenados (usar Git LFS o DVC si se requieren versionar)
models/checkpoints/*.pt
models/checkpoints/*.pth
models/checkpoints/*.h5

# Credenciales y configuración sensible
.env
.env.local
*.env
secrets/
config/local_*.yaml

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Base de datos local
*.db
*.sqlite3
